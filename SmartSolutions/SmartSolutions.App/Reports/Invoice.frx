  </Dictionary>
  <ReportPage Name="Page1" Landscape="false" PaperWidth="210" PaperHeight="297" TopMargin="10" BottomMargin="10" LeftMargin="10" RightMargin="10">
    <ReportTitleBand Name="ReportTitle1" Top="0" Width="190" Height="30">
      <TextObject Name="txtBizName" Left="0"   Top="0"  Width="130" Height="10" Text="[BizName]" Font="Arial, 14pt, Bold"/>
      <TextObject Name="txtNtn"     Left="130" Top="0"  Width="60"  Height="10" Text="NTN: [BizNtn]" HorzAlign="Right"/>
      <TextObject Name="txtTitle"   Left="0"   Top="10" Width="190" Height="10" Text="INVOICE" Font="Arial, 14pt, Bold" HorzAlign="Center"/>
      <TextObject Name="txtOrderId" Left="0"   Top="20" Width="95"  Height="8"  Text="Serial No: [OrderId]"/>
      <TextObject Name="txtDate"    Left="95"  Top="20" Width="95"  Height="8"  Text="Date: [OrderDate]" HorzAlign="Right"/>
    </ReportTitleBand>
    <PageHeaderBand Name="PageHeader1" Top="32" Width="190" Height="12">
      <TextObject Name="hNo"    Left="0"   Top="0" Width="10"  Height="10" Text="No"          Font="Arial, 8pt, Bold"/>
