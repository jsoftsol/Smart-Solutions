      <TextObject Name="hQty"   Left="110" Top="0" Width="20"  Height="10" Text="Qty"         Font="Arial, 8pt, Bold" HorzAlign="Right"/>
      <TextObject Name="hRate"  Left="130" Top="0" Width="30"  Height="10" Text="Rate"        Font="Arial, 8pt, Bold" HorzAlign="Right"/>
      <TextObject Name="hTotal" Left="160" Top="0" Width="30"  Height="10" Text="Total RS"    Font="Arial, 8pt, Bold" HorzAlign="Right"/>
    </PageHeaderBand>
    <DataBand Name="Data1" Top="46" Width="190" Height="10" DataSource="Lines">
      <TextObject Name="dNo"    Left="0"   Top="0" Width="10"  Height="10" Text="[Lines.No]"/>
      <TextObject Name="dDesc"  Left="10"  Top="0" Width="100" Height="10" Text="[Lines.Description]"/>
      <TextObject Name="dQty"   Left="110" Top="0" Width="20"  Height="10" Text="[Lines.Qty]"   HorzAlign="Right"/>
      <TextObject Name="dRate"  Left="130" Top="0" Width="30"  Height="10" Text="[Lines.Rate]"  HorzAlign="Right" Format="Currency" FormatDecimalDigits="2"/>
      <TextObject Name="dTotal" Left="160" Top="0" Width="30"  Height="10" Text="[Lines.Total]" HorzAlign="Right" Format="Currency" FormatDecimalDigits="2"/>
    </DataBand>
    <ReportSummaryBand Name="ReportSummary1" Top="58" Width="190" Height="30">
      <TextObject Name="txtSubtotal" Left="0" Top="0"  Width="190" Height="8" Text="Subtotal: PKR [Subtotal]"       HorzAlign="Right"/>
