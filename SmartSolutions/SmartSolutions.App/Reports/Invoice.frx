      <TextObject Name="txtPaid"     Left="0" Top="16" Width="190" Height="8" Text="Paid: PKR [TotalPaid]"          HorzAlign="Right"/>
      <TextObject Name="txtBalance"  Left="0" Top="24" Width="190" Height="8" Text="Balance: PKR [Balance]"         HorzAlign="Right" Font="Arial, 10pt, Bold"/>
